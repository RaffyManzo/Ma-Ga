{
  "schemaVersion": "0.1",
  "workloadId": "ma_ga_workload_diagnostic",
  "description": "Configurazione diagnostica semplificata del workload MA-GA.",

  "runtimeBinding": {
    "mode": "DOCUMENTATION_ONLY_DIAGNOSTIC",
    "note": "In questa fase i valori sono replicati nella classe Java. La lettura dinamica del JSON verrà introdotta successivamente."
  },

  "semantics": {
    "clockSource": "MOSAIC_SIMULATION_TIME",
    "activationReference": "VEHICLE_APPLICATION_STARTUP",
    "generationMode": "DETERMINISTIC_PERIODIC",
    "deliveryPolicy": "PENDING_TASKS_AT_NEXT_OPTIMIZATION_WINDOW",
    "consumptionPolicy": "REMOVE_AFTER_OFFLOADING_DECISION",
    "remoteExecutionPersistence": "NOT_MODELED",
    "taskIdFormat": "<profileId>__<vehicleId>__t_<activationTimeMs>"
  },

  "profiles": [
    {
      "profileId": "perception_light",
      "inputSizeBits": 8000000,
      "outputSizeBits": 64000,
      "cpuCycles": 1500000000,
      "deadlineSeconds": 0.5,
      "generationPolicy": {
        "type": "PERIODIC",
        "intervalSeconds": 5.0,
        "startOffsetSeconds": 1.0
      },
      "calibrationStatus": "DIAGNOSTIC_SYNTHETIC_VALUE"
    },
    {
      "profileId": "planning_medium",
      "inputSizeBits": 2000000,
      "outputSizeBits": 32000,
      "cpuCycles": 3000000000,
      "deadlineSeconds": 1.0,
      "generationPolicy": {
        "type": "PERIODIC",
        "intervalSeconds": 10.0,
        "startOffsetSeconds": 2.0
      },
      "calibrationStatus": "DIAGNOSTIC_SYNTHETIC_VALUE"
    },
    {
      "profileId": "cooperative_awareness",
      "inputSizeBits": 512000,
      "outputSizeBits": 16000,
      "cpuCycles": 800000000,
      "deadlineSeconds": 0.75,
      "generationPolicy": {
        "type": "PERIODIC",
        "intervalSeconds": 15.0,
        "startOffsetSeconds": 3.0
      },
      "calibrationStatus": "DIAGNOSTIC_SYNTHETIC_VALUE"
    }
  ]
}